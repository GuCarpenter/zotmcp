# Copy to .env for `npm run start` and `npm run test:integration`.
#
# The scaffold needs a path to a Zotero *binary*. A Flatpak install has none, so
# point this at a wrapper script that execs `flatpak run org.zotero.Zotero "$@"`
# and make it executable.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero-or-wrapper
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/a/scratch/zotero/profile
